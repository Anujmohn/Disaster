# ==============================================================================
# Disaster Safety API - Production Environment Configuration Template
# ==============================================================================
# COPY THIS FILE TO .env IN PRODUCTION AND FILL IN STRONG, SECURE CREDENTIALS.
# DO NOT COMMIT REAL PRODUCTION CREDENTIALS TO VERSION CONTROL.
# ==============================================================================

# Application Environment
APP_NAME="Disaster Safety API"
ENVIRONMENT=production

# Server Binding
SERVER_HOST=0.0.0.0
SERVER_PORT=8000

# PostgreSQL + PostGIS Production Connection
# Must point to a managed PostgreSQL 15+ instance with PostGIS 3.x extension enabled.
DB_HOST=your-production-db.internal.cloud
DB_PORT=5432
DB_NAME=disaster_safety_prod
DB_USER=disaster_app_prod
DB_PASSWORD=GENERATE_STRONG_RANDOM_PASSWORD_HERE

# Database Connection Pool Tuning
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_ECHO=false

# Road Network Evacuation Routing (OSRM)
# Set to an internal/dedicated OSRM instance or approved production endpoint.
OSRM_BASE_URL=http://osrm-router:5000
OSRM_TIMEOUT_SECONDS=5.0

# Automated Background Alert Monitoring
ALERT_MONITORING_ENABLED=true
ALERT_MONITORING_INTERVAL_SECONDS=300

# Security: Production CORS Allowed Origins
# Comma-separated list of allowed origins (e.g., your web dashboard domain).
# Wildcard '*' is strictly discouraged in production.
CORS_ALLOWED_ORIGINS=https://disastersafety.in,https://app.disastersafety.in

# API Rate Limiting (per client IP)
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_MINUTE=120

# Structured Production Logging
LOG_LEVEL=INFO
